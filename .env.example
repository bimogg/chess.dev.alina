# Copy this file to .env and fill in your Supabase project credentials.
# Without these, ChessVerse runs in local-only mode (LocalStorage profile,
# demo leaderboard data) — everything still works, just without cloud sync.
#
# How to get them:
# 1. Create a free project at https://supabase.com
# 2. In the Supabase dashboard, open SQL Editor and run:
#      supabase/migrations/001_init.sql
# 3. Open Settings → API and copy:
#    - Project URL → VITE_SUPABASE_URL
#    - anon/public key → VITE_SUPABASE_ANON_KEY

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
